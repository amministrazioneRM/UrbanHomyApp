{
  "name": "urban-homy-utenti",
  "version": "1.0.0",
  "description": "Gestione utenti e accessi del portale Urban Homy: ruoli amministratore/utente per ciascuna applicazione.",
  "main": "src/main.jsx",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --minify --loader:.tsx=tsx --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=dist/bundle.js",
    "watch": "esbuild src/main.tsx --bundle --loader:.tsx=tsx --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --outfile=dist/bundle.js --watch=forever"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "esbuild": "^0.28.2",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
