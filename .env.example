# =============================================================================
# Urban Homy — Environment Variables
# Copy this file to .env and fill in the values.
# Docker Compose reads this file automatically.
# =============================================================================

# --- Database (SQL Server) ---
# Per uso locale con Docker Compose, usa il servizio "sqlserver":
DATABASE_URL=sqlserver://db:1433;database=urbanhomy;user=sa;password=<MSSQL_SA_PASSWORD>;encrypt=true;trustServerCertificate=true
# Per connessione a un'istanza esterna, sostituisci "sqlserver" con l'host remoto.

# Password dell'utente SA del container SQL Server (deve soddisfare i requisiti di complessità di SQL Server)
MSSQL_SA_PASSWORD=<your-strong-password>

# --- Backend API ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
BCRYPT_SALT_ROUNDS=10
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Portal ---
PORTAL_PORT=5173

# --- Frontend (API base URL used at build time) ---
API_BASE_URL=http://localhost:4000/api

# --- Microsoft SSO (Azure AD / Entra ID) ---
# Leave as REPLACE_WITH_YOUR_* to disable SSO in the login page.
MSAL_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID
MSAL_TENANT_ID=REPLACE_WITH_YOUR_TENANT_ID

# --- Seed ---
# Set to "true" to populate the database with sample data on container startup.
# Set to "false" to skip seeding (production).
SEED_SAMPLE_DATA=true
